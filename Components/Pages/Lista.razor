@using System.Collections.Generic

@page "/lista"
@inject NavigationManager Navigation


<h3 class="text-center text-2xl font-semibold mb-4">Selecciona una pregunta</h3>

@if (preguntasVisibles != null)
{
    <div class="flex justify-center">
        <ul class="w-full max-w-xl space-y-2">
            @foreach (var pregunta in preguntasVisibles)
            {
                <li>
                    <button class="bg-gray-200 hover:bg-gray-300 text-black font-medium py-2 px-4 rounded w-full text-left"
                            @onclick="() => SeleccionarPregunta(pregunta)">
                        @pregunta
                    </button>
                </li>
            }
        </ul>
    </div>
}

<hr class="my-6" />

<h4 class="text-lg font-semibold mb-2">Pregunta seleccionada:</h4>
<InputText @bind-Value="preguntaSeleccionada" class="border border-gray-400 p-2 w-full max-w-xl" />

@code {
    private List<string> todasLasPreguntas = new()
    {
        "¿Cómo armar un presupuesto mensual efectivo?",
        "¿Qué porcentaje de mis ingresos debo ahorrar?",
        "¿Qué es el fondo de emergencia y cuánto debo tener?",
        "¿Cómo reducir mis gastos sin afectar mi calidad de vida?",
        "¿Es mejor pagar deudas o ahorrar primero?",
        "¿Cómo salgo más rápido de mis deudas?",
        "¿Cómo funciona el buró de crédito y cómo afecta mi historial?",
        "¿Qué es el CAT (Costo Anual Total) y por qué importa?",
        "¿Cuándo conviene consolidar mis deudas?",
        "¿Cuál es el riesgo de pagar solo el mínimo en una tarjeta de crédito?",
        "¿Dónde puedo invertir dinero en México con bajo riesgo?",
        "¿Qué son los CETES y cómo funcionan?",
        "¿Qué diferencia hay entre inversión a corto y largo plazo?",
        "¿Qué perfil de riesgo tengo como inversionista?",
        "¿Qué plataformas seguras existen para invertir en México?",
        "¿Qué es un estado de resultados y cómo se interpreta?",
        "¿Qué es un balance general?",
        "¿Qué es la contabilidad de costos?",
        "¿Cuál es la diferencia entre activo y pasivo?",
        "¿Qué es el flujo de efectivo y por qué es importante?",
        "¿Cómo llevar la contabilidad de mi negocio pequeño?",
        "¿Qué software gratuito o barato puedo usar para contabilidad personal?",
        "¿Qué documentos debo guardar para mi contabilidad?",
        "¿Qué es una póliza contable?",
        "¿Qué es la conciliación bancaria?",
        "¿Qué régimen fiscal me conviene si soy freelance?",
        "¿Cuál es la diferencia entre RESICO y Persona Física con Actividad Empresarial?",
        "¿Cómo emito una factura (CFDI)?",
        "¿Cuánto debo pagar de impuestos si soy independiente?",
        "¿Cómo me doy de alta en el SAT?",
        "¿Cuándo se presenta la declaración anual?",
        "¿Qué puedo deducir en mi declaración anual?",
        "¿Qué pasa si no presento mis declaraciones?",
        "¿Cómo presento mis declaraciones mensuales?",
        "¿Cómo me ayuda un contador y cuánto cobra generalmente?",
        "¿Cómo planificar para el retiro en México?",
        "¿Qué es una AFORE y cómo sé cuál tengo?",
        "¿Qué tipo de seguro financiero me conviene (vida, gastos médicos)?",
        "¿Cómo empiezo un fondo para la educación de mis hijos?",
        "¿Qué debo hacer antes de pedir un crédito hipotecario?"
    };

    private List<string> preguntasVisibles = new();
    private string preguntaSeleccionada = string.Empty;

    protected override void OnInitialized()
    {
        preguntasVisibles = todasLasPreguntas.Take(10).ToList();
    }

    private void SeleccionarPregunta(string pregunta)
    {
        preguntaSeleccionada = pregunta;
    }
}
