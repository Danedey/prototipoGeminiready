    };

    private List<string> preguntasVisibles = new();
    private string preguntaSeleccionada = string.Empty;

    protected override void OnInitialized()
    {
        preguntasVisibles = todasLasPreguntas.Take(10).ToList();
    }

    private void SeleccionarPregunta(string pregunta)
    {
        preguntaSeleccionada = pregunta;
        Pregunta = pregunta;
       
    }

    private void MiAccion()
    {
        // Ejemplo: regresar al inicio
        Navigation.NavigateTo("/Cambiarcontrasena");
    }


    async Task Enviar()
    {
        Respuesta = "Cargando...";
        Respuesta = await Gemini.EnviarPreguntaAsync(Pregunta);
    }
}
