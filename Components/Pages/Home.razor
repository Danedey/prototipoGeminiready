@page "/"
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation
@inject AlertService AlertService


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f9f9f9;
        color: #333;
        }

        .form-container {
        padding: 20px;
        margin: auto;
        max-width: 400px;
        text-align: left;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }


        header h1 {
        font-size: 1.8rem;
        color: #007BFF;
        margin-bottom: 10px;
        text-align: center;
        }



        header h2 {
        font-size: 1rem;

        margin-bottom: 20px;
        }

        form label {
        display: block;
        margin: 10px 0 5px;
        font-weight: bold;
        color: #333;
        }

        form input {
        width: 100%;
        padding: 10px;
        border: 1px solid #007BFF;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 1rem;
        }

        form input:focus {
        outline: none;
        border-color: #0056b3;
        }

        .btn-submit {
        display: block;
        width: 100%;
        padding: 10px;
        background-color: #007BFF;
        color: white;
        border: 15px solid #007BFF; /* Borde azul de 15px */
        border-radius: 10px;
        font-size: 1rem;
        cursor: pointer;
        }

        .btn-submit:hover {
        background-color: #0056b3;
        border-color: #0056b3; /* Cambia el borde a un azul más oscuro */
        }

        .btn-submit-gray {
        display: block;
        width: 100%;
        padding: 10px;
        background-color: #E8EDF2;
        color: black;
        border: 15px solid #E8EDF2; /* Borde azul de 15px */
        border-radius: 10px;
        font-size: 1rem;
        cursor: pointer;
        }

        .btn-submit-gray:hover {
        background-color: #637587;
        border-color: #637587; /* Cambia el borde a un azul más oscuro */
        }

        .button {
        display: block;
        width: 90%;
        margin: 10px auto;
        padding: 15px;
        font-size: 16px;
        font-weight: bold;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .button-blue {
        background-color: #007bff;
        color: #fff;
        }

        .button-blue:hover {
        background-color: #0056b3;
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);
        }

        .button-gray {
        background-color: #e0e0e0;
        color: #333;
        }

        .button-gray:hover {
        background-color: #d6d6d6;
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(200, 200, 200, 0.3);
        }

        .test-mode-button {
            position: fixed;
            top: 18px;
            right: 18px;
            z-index: 1000;
            background: #ff9800;
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 10px 16px;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .test-mode-button:hover {
            background: #f57c00;
        }

    </style>
</head>
<body>
    <button type="button" class="test-mode-button" @onclick="EntrarModoPrueba">Test mode</button>

    <div class="form-container">
        <header>
            <h1>TaxMexBot</h1>
            <h2>Asistencia simple, decisiones grandes</h2>
        </header>
        <form>
            <label for="rfc">RFC</label>
            <input type="text" id="rfc" placeholder="Ingrese su rfc" @bind-value=rfcValor />

            <label for="contrasena">Contraseña</label>
            <input type="password" id="contrasena" placeholder="Ingrese su contraseña"  @bind-value=contrasena/>

            <button type="button" class="button button-blue" @onclick="iniciarSesion_Click">Iniciar sesion</button>
            <a href="#" class="button button-blue" style="background-color: transparent; color: #007bff; border: none; padding: 10px; text-align: center;" @onclick="olvidarContra_Click">
                Olvidé mi contraseña
            </a>
            <div style="margin-top: 10px; text-align: left;">
                ¿No tienes cuenta?
                <a href="#" style="color: #007bff; font-weight: bold; text-decoration: none;" @onclick="crearCuenta">Crea una</a>
            </div>

        </form>
    </div>
</body>
</html>


@code {
    string rfcValor = string.Empty;
    string contrasena = string.Empty;

    bool EsValido(string texto)
    {
        return texto.Length >= 12 && texto.Length <= 13 && !texto.Contains(" ");
    }


    private async Task iniciarSesion_Click()
    {
        if (string.IsNullOrWhiteSpace(rfcValor) || string.IsNullOrWhiteSpace(contrasena))
        {
            await AlertService.ShowAlertAsync("Advertencia", "RFC o contraseña no válidos", "OK");
            return;
        }

        if (!EsValido(rfcValor))
        {
            await AlertService.ShowAlertAsync("Advertencia", "El formato del RFC no es válido", "OK");
            return;
        }

        try
        {
            var esValido = await UsuarioService.ValidarCredencialesAsync(rfcValor, contrasena);

            if (!esValido)
            {
                await AlertService.ShowAlertAsync("Error", "Credenciales incorrectas", "OK");
                return;
            }

            Navigation.NavigateTo("/MainChat");
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"No se pudo iniciar sesión: {ex.Message}", "OK");
        }
    }

    public void olvidarContra_Click()
    {
        Navigation.NavigateTo("/Olvidarcontrasena");
    }

    private void crearCuenta()
    {
        Navigation.NavigateTo("/Registro");
    }

    private void EntrarModoPrueba()
    {
        rfcValor = "XAXX010101000";
        contrasena = "testmode";
        Navigation.NavigateTo("/MainChat");
    }

}

